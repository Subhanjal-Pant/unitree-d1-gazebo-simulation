<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="d1_550">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import d1_550 urdf file -->
    <xacro:include filename="$(find d1_550_bringup)/urdf/d1_550_gazebo.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="d1_550.ros2_control.xacro" />


    <xacro:d1_550_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
